#!/usr/bin/env bash
# Nothing lands on main unless scripts/build-site.sh passes.
#
# Turn this hook on once per clone:   git config core.hooksPath .githooks
#
# The build runs on the working tree, so it also refuses to push main while
# tracked files have uncommitted changes: the build would not be testing what
# is pushed.
set -euo pipefail

pushing_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then pushing_main=1; fi
done
[ "$pushing_main" = 1 ] || exit 0

cd "$(git rev-parse --show-toplevel)"
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "pre-push: commit or stash your changes first; the site build must test what is pushed" >&2
  exit 1
fi
echo "pre-push: running scripts/build-site.sh before pushing main"
scripts/build-site.sh
if [ -n "$(git status --porcelain -- .kiro/specs)" ]; then
  echo "pre-push: .kiro/specs changed during the build; commit the regenerated specs" >&2
  exit 1
fi
